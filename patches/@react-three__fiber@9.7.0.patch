diff --git a/dist/timer-clock.cjs b/dist/timer-clock.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..3d64444ef09c21e77c57b7741f0d076c6d06b122
--- /dev/null
+++ b/dist/timer-clock.cjs
@@ -0,0 +1,55 @@
+// Preserve the v9 clock API while advancing Timer exactly once per frame.
+class TimerClock {
+  constructor (Timer, autoStart = true) {
+    this.autoStart = autoStart
+    this.running = false
+    this.startTime = 0
+    this.oldTime = 0
+    this.elapsedTime = 0
+    this.delta = 0
+    this.timer = new Timer()
+    if (typeof document !== 'undefined') this.timer.connect(document)
+  }
+
+  start () {
+    this.timer.reset()
+    this.startTime = performance.now()
+    this.oldTime = this.startTime
+    this.elapsedTime = 0
+    this.delta = 0
+    this.running = true
+  }
+
+  stop () {
+    this.running = false
+    this.autoStart = false
+    this.delta = 0
+  }
+
+  update (timestamp) {
+    if (this.autoStart && !this.running) {
+      this.start()
+      return
+    }
+    if (!this.running) return
+    this.timer.update(timestamp)
+    this.delta = this.timer.getDelta()
+    this.elapsedTime += this.delta
+    this.oldTime = timestamp === undefined ? performance.now() : timestamp
+  }
+
+  getDelta () {
+    return this.delta
+  }
+
+  getElapsedTime () {
+    return this.elapsedTime
+  }
+
+  dispose () {
+    this.stop()
+    this.timer.dispose()
+  }
+}
+
+module.exports = TimerClock
